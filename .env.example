# Copy this file to .env and fill in real values before running: make up
# .env is gitignored — never commit it.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
# Generate a separate random password (e.g. openssl rand -hex 24).
DEBEZIUM_PASSWORD=change_me_replication_password

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password

# ── MariaDB (Hive Metastore backend) ─────────────────────────────────────────
MARIADB_ROOT_PASSWORD=change_me_strong_root_password
MARIADB_HIVE_PASSWORD=change_me_hive_password

# ── Apache Superset ───────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=change_me_32_char_random_secret_key
SUPERSET_ADMIN_PASSWORD=change_me_admin_password

# ── API Service (Phase 2) ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
API_SECRET_KEY=change_me_api_jwt_secret_key
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Password for the default 'admin' user seeded into the api_users table
API_ADMIN_PASSWORD=change_me_admin_password
# Comma-separated allowed CORS origins.
# For remote servers, add the public IP: http://<VM_PUBLIC_IP>:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Monitoring / Grafana (Phase 4) ────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ── Alerting (Phase 4) ────────────────────────────────────────────────────────
# Optional: Slack webhook URL for alert notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
