# Template — rendered by: scripts/generate_configs.sh
# Output:   config/trino/catalog/iceberg.properties  (gitignored)

# Trino Iceberg catalog — backed by Hive Metastore + MinIO
connector.name=iceberg
iceberg.catalog.type=hive_metastore

# Hive Metastore (thrift)
hive.metastore.uri=thrift://hive-metastore:9083

# MinIO / S3-compatible storage — credentials from .env
hive.s3.endpoint=http://minio:9000
hive.s3.aws-access-key=${MINIO_ROOT_USER}
hive.s3.aws-secret-key=${MINIO_ROOT_PASSWORD}
hive.s3.path-style-access=true
hive.s3.ssl.enabled=false

# Iceberg defaults
iceberg.file-format=PARQUET
iceberg.compression-codec=SNAPPY
iceberg.target-max-file-size=128MB

# Do not register arbitrary external tables through Trino
iceberg.register-table-procedure.enabled=false
