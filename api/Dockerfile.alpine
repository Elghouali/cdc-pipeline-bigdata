# Experimental alternative runtime. Build dependencies never enter runtime.
FROM python:3.11-alpine AS wheels
WORKDIR /build
RUN apk upgrade --no-cache && apk add --no-cache gcc g++ musl-dev linux-headers
COPY requirements.txt ./
# aiokafka has no matching musllinux wheel in the observed package index.
# Build it from source; require binary wheels for all other dependencies.
RUN pip wheel --wheel-dir /wheels --only-binary=:all: --no-binary=aiokafka -r requirements.txt

FROM python:3.11-alpine AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache libgcc libstdc++ \
    && addgroup -g 10001 cdc && adduser -D -H -u 10001 -G cdc cdc
COPY requirements.txt ./
RUN --mount=type=bind,from=wheels,source=/wheels,target=/wheels \
    pip install --no-index --find-links=/wheels -r requirements.txt \
    && python -m pip check \
    && python -c "import fastapi,uvicorn,asyncpg,aiokafka,passlib,bcrypt,jwt"
COPY . .
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/', timeout=4)"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
